@{
    Layout = null;
}



<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Login </title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/normarlize.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/DrivingLicense.styles.css" asp-append-version="true" />
</head>

<!-- breadcrumb start -->

<!-- Start Login -->


<!-- Start Video -->
<div class="video">
    <video autoplay muted loop>
        <source src="images/video2.mp4" type="video/mp4" />
    </video>
    <div class="form">
        <div class="content">
            <h2>Login Your Account </h2>
         
            <form method="post"
                  asp-controller="Account" asp-action="Login"
                  class="theme-form">


                <input class="input" type="text" name="identifier" placeholder="Account Number" />

                <input  type="password" class="input" id="Password" placeholder="PIN" />

                <button type="submit" class="btn btn-primary">Login</button>

            </form>
        </div>
    </div>
</div>
<!-- End Video -->

