<div class="main-menue" id="main-menue">
    <div class="container">

        <h2 class="title-one text-center mb-4">Deposit</h2>

        <form asp-action="Deposit" method="post" class="p-4 border rounded shadow-sm bg-light">

            <div class="form-group mb-3">
                <label for="depositAmount" class="fw-bold">Amount to Deposit</label>
                <input type="number" step="0.01" name="depositAmount" class="form-control" required />
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-success">Confirm Deposit</button>
                <a asp-action="MainMenueScreen" class="btn btn-secondary">Back</a>
            </div>

        </form>

    </div>
</div>
