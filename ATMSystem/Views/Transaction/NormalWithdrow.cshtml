<div class="main-menue" id="main-menue">
    <div class="container">

        <h2 class="title-one text-center mb-4">Withdraw</h2>

        <form asp-action="Withdraw" method="post" class="p-4 border rounded shadow-sm bg-light">

            <input type="hidden" name="clientId" value="" />

            <div class="form-group mb-3">
                <label class="fw-bold">Account Number</label>
                <input type="text" value="" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label class="fw-bold">Current Balance</label>
                <input type="text" value="" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label for="withdrawAmount" class="fw-bold">Amount to Withdraw</label>
                <input type="number" step="0.01" name="withdrawAmount" class="form-control" required />
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-danger">Withdraw</button>
                <a asp-action="MainMenueScreen" class="btn btn-secondary">Back</a>
            </div>

        </form>

    </div>
</div>
