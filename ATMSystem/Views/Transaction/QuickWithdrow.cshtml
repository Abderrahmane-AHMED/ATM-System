@model Domain.TbClient

<div class="main-menue" id="main-menue">
    <div class="container">
    <h5 class="title-one">Quick Withdraw</h5>

        <div class="services-container">

        @foreach (var amount in new[] { 10, 20, 50, 100, 200, 300 ,400 ,500 })
        {
            <div class="srv-box">
                    <form asp-action="QuickWithdraw" method="post">
                    <input type="hidden" name="amount" value="@amount" />
                    <button type="submit" class="btn btn-primary btn-lg btn-block">
                            @amount €
                    </button>
                </form>
            </div>
        }

    </div>
        <a asp-controller="Home" asp-action="MainMenueScreen" class="btn btn-secondary mt-3">Back</a>
   
</div>
</div>


